    "#| echo: false\n",
    "def demandas_records(sheet: str, name_fix: dict) -> list[dict]:\n",
    "    df = pd.read_csv(sheet_csv_url(sheet))\n",
    "    df[\"departamento\"] = df[\"DEPARTAMENTO\"].str.strip().replace(name_fix)\n",
    "    df[\"relacion\"] = df[\"RELACION CON GRD (ALTA, MEDIA, BAJA)\"].astype(str).str.strip().str.upper()\n",
    "    alta = df[df[\"relacion\"].isin([\"ALTA\", \"ALTO\"])]\n",
    "\n",
    "    counts = alta.groupby(\"departamento\").size()\n",
    "    retos = alta.groupby(\"departamento\")[\"RETO\"].apply(lambda s: list(dict.fromkeys(s))[:3])\n",
    "\n",
    "    return [\n",
    "        {\n",
    "            \"name\": n,\n",
    "            \"count\": int(counts.get(n, 0)),\n",
    "            \"lines\": [r[:70] for r in retos.get(n, [])],\n",
    "        }\n",
    "        for n in ALL_DEPT_NAMES\n",
    "    ]\n",
    "\n",
    "\n",
    "# The DEPARTAMENTO cell for San Andrés is truncated at the source; reconstruct it.\n",
    "demandas_2022 = demandas_records(\n",
    "    \"Demandas-Territoriales-2022-24\",\n",
    "    {\"rés, Providencia y Santa\": \"San Andrés, Providencia y Santa Catalina\"},\n",
    ")\n",
    "# This sheet spells the capital district \"Bogotá\"; align it with \"Bogotá D.C.\".\n",
    "demandas_2025 = demandas_records(\"Demandas-Territoriales-2025-26\", {\"Bogotá\": \"Bogotá D.C.\"})\n",
    "\n",
    "ojs_define(demandas_2022=demandas_2022, demandas_2025=demandas_2025)"
   ]
