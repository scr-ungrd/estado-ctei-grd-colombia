    "//| echo: false\n",
    "demandFigure(demandas_2025, colombia_geo, {\n",
    "  mapTitle: \"Mapa de demandas territoriales con relación ALTA a GRD, por departamento (bienio 2025-2026)\",\n",
    "  barTitle: \"Ranking de departamentos por demandas ALTA (bienio 2025-2026)\"\n",
    "})\n",
    "```\n",
